# R Server MCP - Optimized Docker Image
# Multi-platform support for x86_64 and ARM64

FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Install system dependencies and R packages in one layer
RUN apt-get update && apt-get install -y \
    # System utilities
    locales \
    curl \
    wget \
    # R and development tools
    r-base \
    r-base-dev \
    # Pre-compiled R packages (much faster than CRAN)
    r-cran-readxl \
    r-cran-writexl \
    r-cran-dplyr \
    r-cran-tidyr \
    r-cran-ggplot2 \
    r-cran-cowplot \
    r-cran-stringr \
    r-cran-lubridate \
    # System libraries for R packages
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libfontconfig1-dev \
    libcairo2-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    && rm -rf /var/lib/apt/lists/*

# Set up UTF-8 locale
RUN locale-gen en_US.UTF-8

# Set CRAN repository
RUN echo 'options(repos = c(CRAN = "https://cloud.r-project.org/"))' >> /usr/lib/R/etc/Rprofile.site

# Verify R packages are installed
RUN Rscript -e "cat('Checking R packages...\n'); packages <- c('readxl', 'writexl', 'dplyr', 'tidyr', 'ggplot2', 'cowplot'); for(pkg in packages) { if(!require(pkg, character.only=TRUE, quietly=TRUE)) stop(paste('Package', pkg, 'not available')) }; cat('All packages ready!\n')"

# Set working directory
WORKDIR /workspace

# Keep container running
CMD ["tail", "-f", "/dev/null"]

# Labels for metadata
LABEL org.opencontainers.image.title="R Server MCP"
LABEL org.opencontainers.image.description="Optimized R environment for MCP server with pre-installed packages"
LABEL org.opencontainers.image.source="https://github.com/saidsurucu/rlang-mcp-python"
LABEL org.opencontainers.image.licenses="CC-BY-NC-4.0"